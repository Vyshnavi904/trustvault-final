{
  "ConnectionStrings": {
    "DefaultConnection": "Host=your-supabase-host;Port=5432;Database=postgres;Username=postgres;Password=your-password;SSL Mode=Require;Trust Server Certificate=true"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "TrustVault",
    "Audience": "TrustVaultUsers"
  },
  "Supabase": {
    "Url": "https://your-project.supabase.co",
    "ServiceKey": "your-service-role-key",
    "Bucket": "documents"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173,https://your-netlify-app.netlify.app"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
